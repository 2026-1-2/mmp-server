# 서버 포트
PORT=3000

# JWT 시크릿 (반드시 변경)
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production

# 데이터베이스 설정
DB_PORT=30012
DB_DATABASE=mmp_db
DB_USERNAME=mmp
DB_PASSWORD=asdf
# Docker 외부에서 직접 실행할 때 사용
DATABASE_URL=mysql://mmp:asdf@localhost:30012/mmp_db

# MediaMTX 내부 API 주소 (컨테이너끼리 통신 — Docker 사용 시 수정 불필요)
MEDIAMTX_URL=http://mediamtx:9997
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889

# 브라우저에서 MediaMTX에 직접 접근할 호스트
# 로컬: localhost / 서버 배포: 실제 IP 또는 도메인
MEDIAMTX_PUBLIC_HOST=localhost

# VOD 녹화 파일 경로
RECORDINGS_DIR=./recordings

# RTSP 채널 초기 등록 (선택, JSON 배열)
# RTSP_CHANNELS=[{"channelId":"cam1","rtspUrl":"rtsp://id:pw@host/path"}]
RTSP_CHANNELS=

# ONVIF PTZ 카메라 설정
ONVIF_CAMERAS=[{"cameraId":"cam-01","hostname":"192.168.0.100","port":8080,"username":"admin","password":"password"}]
